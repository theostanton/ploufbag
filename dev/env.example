# Copy to dev/.env.local (gitignored) and fill in.
#
# Only the Mapbox token really matters: the DATABASE_* values come from
# dev/db.sh, and SESSION_SECRET defaults to a throwaway string.
#
# A public Mapbox token (pk.*) is the right kind to use here. It is already
# shipped to the browser in the built site, so it is not a secret in the way a
# server key is -- but scope it to localhost in the Mapbox dashboard anyway.

NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# Optional overrides
# SITE_PORT=3000
# SESSION_SECRET=dev-session-secret-not-for-any-real-use
